# Copiar a .env.local y completar. .env.local no se versiona.
#
# Nomenclatura: este proyecto usa el sistema de claves nuevo de Supabase
# (sb_publishable_... / sb_secret_...), no las claves legacy anon/service_role
# que eran JWT. Ver CLAUDE.md seccion 7.

# URL del proyecto Supabase. Se usa tambien para derivar el hostname
# permitido en next.config.mjs -> images.remotePatterns.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# Clave publicable. Va al cliente y es publica por diseno: lo que protege
# los datos es RLS, no el secreto de esta clave.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx

# Clave secreta. Bypassea RLS por completo.
# Server-only: nunca importarla desde un componente cliente ni prefijarla
# con NEXT_PUBLIC_. Ver CLAUDE.md seccion 7.
SUPABASE_SECRET_KEY=

# Secreto compartido que protege /api/revalidate.
# Generar con: openssl rand -base64 32
REVALIDATION_SECRET=

# Dominio real del sitio. Se usa para las URLs canonicas, el sitemap y
# OpenGraph. El dominio de la Liga Metropolitana todavia no se conecta:
# completar cuando exista.
NEXT_PUBLIC_SITE_URL=

# Token de larga duracion de la API de Instagram, para la seccion de Reels.
# Server-only. Dura 60 dias y hay que refrescarlo antes de que venza: vencido
# no se puede refrescar y hay que rehacer la autorizacion desde cero.
# Se obtiene con el flujo de Instagram business login (ver EXECUTION_PLAN.md).
INSTAGRAM_ACCESS_TOKEN=

# --- Formularios de /contacto y /jugadores ------------------------------------

# API key de Resend (https://resend.com). Server-only.
# Sin ella los formularios no mandan nada y avisan que el envio no esta
# configurado, en vez de fingir que salio.
RESEND_API_KEY=

# A donde llegan los mensajes de los formularios. Server-only.
CORREO_DESTINO=

# De donde salen. Resend exige que el dominio este verificado en su panel.
# Mientras la Liga no tenga dominio propio, dejarla vacia: el codigo cae en
# onboarding@resend.dev, que Resend permite sin verificar nada PERO solo
# entrega a la casilla dueña de la cuenta de Resend.
# Con dominio propio: "Liga Metropolitana <contacto@eldominio.cl>"
CORREO_REMITENTE=

